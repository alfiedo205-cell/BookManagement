@model BookManagement.Models.Book

<h1>Chi tiết sách</h1>

<p>
    <strong>ID:</strong>
    @Model.Id
</p>

<p>
    <strong>Tên sách:</strong>
    @Model.Name
</p>

<p>
    <strong>Giá:</strong>
    @Model.Price.ToString("N0") VNĐ
</p>

<p>
    <strong>Mô tả:</strong>
    @Model.Description
</p>

<a href="/Book">Quay lại danh sách</a>